APPLICATION = practice2_exo1_lorawan
BOARD ?= esp32-wroom-32
RIOTBASE ?= $(CURDIR)/../../..

# OTAA credentials. Override these from the command line before flashing.
DEVEUI ?= 0000000000000000
APPEUI ?= 0000000000000000
APPKEY ?= 00000000000000000000000000000000

# The UMDK RF 107 module is expected to expose an SX1276-compatible radio.
# Keep DRIVER=sx1276 unless your module documentation explicitly says SX1272.
DRIVER ?= sx1276
LORA_REGION ?= EU868

JOIN_RETRY_MIN_MS ?= 1000
JOIN_RETRY_MAX_MS ?= 5000
UPLINK_RETRY_MIN_MS ?= 2000
UPLINK_RETRY_MAX_MS ?= 10000
MAX_JOIN_ATTEMPTS ?= 5
MAX_UPLINK_ATTEMPTS ?= 5

USEPKG += semtech-loramac
USEMODULE += auto_init_loramac
USEMODULE += $(DRIVER)
USEMODULE += fmt
USEMODULE += random
USEMODULE += xtimer

CFLAGS += -I$(CURDIR)/include
CFLAGS += -DCONFIG_LORAMAC_DEV_EUI_DEFAULT=\"$(DEVEUI)\"
CFLAGS += -DCONFIG_LORAMAC_APP_EUI_DEFAULT=\"$(APPEUI)\"
CFLAGS += -DCONFIG_LORAMAC_APP_KEY_DEFAULT=\"$(APPKEY)\"
CFLAGS += -DJOIN_RETRY_MIN_MS=$(JOIN_RETRY_MIN_MS)
CFLAGS += -DJOIN_RETRY_MAX_MS=$(JOIN_RETRY_MAX_MS)
CFLAGS += -DUPLINK_RETRY_MIN_MS=$(UPLINK_RETRY_MIN_MS)
CFLAGS += -DUPLINK_RETRY_MAX_MS=$(UPLINK_RETRY_MAX_MS)
CFLAGS += -DMAX_JOIN_ATTEMPTS=$(MAX_JOIN_ATTEMPTS)
CFLAGS += -DMAX_UPLINK_ATTEMPTS=$(MAX_UPLINK_ATTEMPTS)

DEVELHELP ?= 1
QUIET ?= 1

include $(RIOTBASE)/Makefile.include
